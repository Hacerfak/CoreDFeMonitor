<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CoreDFeMonitor.UI.ViewModels"
    xmlns:core="using:CoreDFeMonitor.Core.Entities"
    xmlns:dto="using:CoreDFeMonitor.Application.Features.Documentos.Dtos"
    xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:Class="CoreDFeMonitor.UI.Views.DocumentosView"
    x:DataType="vm:DocumentosViewModel"
    x:Name="RootControl">

    <Grid ColumnDefinitions="260, 320, *">

        <!-- ========================================== -->
        <!-- COLUNA 0: MENU LATERAL                     -->
        <!-- ========================================== -->
        <Border Grid.Column="0" Background="#2C3E50" Padding="0,20">
            <StackPanel Spacing="10">
                <TextBlock Text="DFe Monitor" Foreground="White" FontSize="24" FontWeight="Bold"
                    Margin="25,0,20,35" />
                <Button Background="Transparent" Foreground="#BDC3C7" HorizontalAlignment="Stretch"
                    Padding="25,18" CornerRadius="0" Command="{Binding NavegarDashboardCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <icons:MaterialIcon Kind="ViewDashboard" Width="22" Height="22"
                            Foreground="#BDC3C7" />
                        <TextBlock Text="Visão Geral" VerticalAlignment="Center" FontSize="16" />
                    </StackPanel>
                </Button>
                <Button Background="#34495E" Foreground="White" HorizontalAlignment="Stretch"
                    Padding="25,18" CornerRadius="0">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <icons:MaterialIcon Kind="FileDocumentMultiple" Width="22" Height="22"
                            Foreground="White" />
                        <TextBlock Text="Documentos" VerticalAlignment="Center" FontSize="16" />
                    </StackPanel>
                </Button>
                <Button Background="Transparent" Foreground="#BDC3C7" HorizontalAlignment="Stretch"
                    Padding="25,18" CornerRadius="0" Command="{Binding NavegarConfiguracoesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <icons:MaterialIcon Kind="Cog" Width="22" Height="22" Foreground="#BDC3C7" />
                        <TextBlock Text="Configurações" VerticalAlignment="Center" FontSize="16" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ========================================== -->
        <!-- COLUNA 1: LISTA DE EMITENTES (MESTRE)      -->
        <!-- ========================================== -->
        <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, Auto, *">
                <StackPanel Grid.Row="0" Margin="20,25" Spacing="5">
                    <TextBlock Text="Fornecedores" FontSize="22" FontWeight="Bold"
                        Foreground="#333333" />
                    <TextBlock Text="Selecione um emitente para filtrar as notas." FontSize="13"
                        Foreground="Gray" TextWrapping="Wrap" />
                </StackPanel>
                <Separator Grid.Row="1" Background="#EEEEEE" Margin="0" />
                <ListBox Grid.Row="2" ItemsSource="{Binding ListaEmitentes}"
                    SelectedItem="{Binding EmitenteSelecionado}" Background="Transparent"
                    BorderThickness="0" Margin="0,10,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="core:Emitente">
                            <Border Padding="15,10" CornerRadius="8" Background="Transparent">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding RazaoSocial}" FontWeight="SemiBold"
                                        FontSize="14" Foreground="#222222"
                                        TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <icons:MaterialIcon Kind="Domain" Width="16" Height="16"
                                            Foreground="Gray" />
                                        <TextBlock Text="{Binding Cnpj}" FontSize="12"
                                            Foreground="Gray" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- COLUNA 2: DOCUMENTOS E FILTROS (DETALHE)   -->
        <!-- ========================================== -->
        <Grid Grid.Column="2" Background="#F5F5F5" RowDefinitions="Auto, Auto, *">
            <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="4" Foreground="#6200EE"
                IsVisible="{Binding IsCarregando}" />

            <Border Grid.Row="1" Background="White" CornerRadius="0,0,12,12" Padding="30,20"
                BoxShadow="0 4 10 0 #0D000000">
                <StackPanel Spacing="15">
                    <TextBlock Text="Repositório de DF-es" FontSize="24" FontWeight="SemiBold"
                        Foreground="#333333" />

                    <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto" Margin="0,10,0,0">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding ListaEmpresas}"
                            SelectedItem="{Binding EmpresaSelecionada}" Width="200"
                            Margin="0,0,15,0" ToolTip.Tip="Empresa Destinatária">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RazaoSocial}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <DatePicker Grid.Column="1" SelectedDate="{Binding DataInicio}" Width="140"
                            Margin="0,0,15,0" />
                        <DatePicker Grid.Column="2" SelectedDate="{Binding DataFim}" Width="140"
                            Margin="0,0,15,0" />

                        <ComboBox Grid.Column="3" ItemsSource="{Binding ListaTipos}"
                            SelectedItem="{Binding TipoSelecionado}" Width="130" Margin="0,0,15,0" />

                        <TextBox Grid.Column="4" Text="{Binding FiltroTexto}"
                            PlaceholderText="Buscar por Chave..." Margin="0,0,15,0"
                            VerticalAlignment="Center" />
                        <Button Grid.Column="5" Content="Filtrar"
                            Command="{Binding CarregarDocumentosCommand}" Background="#6200EE"
                            Foreground="White" Padding="25,8" CornerRadius="8" FontWeight="Bold" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20" Margin="30"
                BoxShadow="0 8 20 0 #1A000000">
                <Grid RowDefinitions="Auto, *">
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Documentos}"
                        AutoGenerateColumns="False" IsReadOnly="True"
                        CanUserResizeColumns="True" CanUserSortColumns="True"
                        Background="Transparent" RowBackground="Transparent">
                        <DataGrid.Columns>

                            <!-- COLUNAS DE DADOS -->
                            <DataGridTextColumn Header="Data"
                                Binding="{Binding Dados.DataEmissao, StringFormat='dd/MM/yyyy'}"
                                Width="100" />

                            <DataGridTemplateColumn Header="Tipo" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vm:DocumentoItemViewModel">
                                        <Border Background="#F0F0F0" CornerRadius="4" Padding="6,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Dados.SchemaDisplay}"
                                                FontSize="11" FontWeight="SemiBold"
                                                Foreground="#6200EE" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Número" Binding="{Binding Dados.Numero}"
                                Width="90" FontWeight="Bold" />
                            <DataGridTextColumn Header="Chave de Acesso"
                                Binding="{Binding Dados.ChaveAcesso}" Width="250" Foreground="Gray"
                                FontSize="11" />
                            <DataGridTextColumn Header="Valor" Binding="{Binding Dados.ValorTotal}"
                                Width="110" Foreground="#4CAF50" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Manifestação / Evento"
                                Binding="{Binding Dados.StatusManifestacao}" Width="180"
                                Foreground="#FF9800" FontWeight="SemiBold" />

                            <!-- COLUNA DE AÇÕES INDIVIDUAIS -->
                            <DataGridTemplateColumn Header="Ações" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vm:DocumentoItemViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                            HorizontalAlignment="Center">

                                            <!-- Consultar Sefaz -->
                                            <Button Background="Transparent" Padding="5"
                                                ToolTip.Tip="Consultar Situação na Sefaz"
                                                Command="{Binding #RootControl.DataContext.ConsultarStatusNFeCommand}"
                                                CommandParameter="{Binding Dados}">
                                                <icons:MaterialIcon Kind="Magnify"
                                                    Foreground="#2196F3" Width="18" Height="18" />
                                            </Button>

                                            <!-- Menu de Manifestações -->
                                            <Button Background="Transparent" Padding="5"
                                                ToolTip.Tip="Opções de Manifestação">
                                                <icons:MaterialIcon Kind="Handshake"
                                                    Foreground="#FF9800" Width="18" Height="18" />
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="Confirmar Operação"
                                                            Command="{Binding #RootControl.DataContext.ManifestarConfirmacaoCommand}"
                                                            CommandParameter="{Binding Dados}">
                                                            <MenuItem.Icon>
                                                                <icons:MaterialIcon
                                                                    Kind="ThumbUpOutline"
                                                                    Foreground="Green" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem
                                                            Header="Desconhecimento da Operação"
                                                            Command="{Binding #RootControl.DataContext.ManifestarDesconhecimentoCommand}"
                                                            CommandParameter="{Binding Dados}">
                                                            <MenuItem.Icon>
                                                                <icons:MaterialIcon
                                                                    Kind="HelpCircleOutline"
                                                                    Foreground="Orange" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Operação Não Realizada"
                                                            Command="{Binding #RootControl.DataContext.ManifestarNaoRealizadaCommand}"
                                                            CommandParameter="{Binding Dados}">
                                                            <MenuItem.Icon>
                                                                <icons:MaterialIcon Kind="Cancel"
                                                                    Foreground="Red" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>

                                            <!-- Imprimir DANFE (Oculto se for Evento) -->
                                            <Button Background="Transparent" Padding="5"
                                                ToolTip.Tip="Imprimir DANFE"
                                                IsVisible="{Binding Dados.SchemaDisplay, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter='Evento'}"
                                                Command="{Binding #RootControl.DataContext.ImprimirDanfeCommand}"
                                                CommandParameter="{Binding Dados}">
                                                <icons:MaterialIcon Kind="Printer"
                                                    Foreground="#6200EE" Width="18" Height="18" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>